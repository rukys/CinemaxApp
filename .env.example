# Copy this file to .env and fill in the values. Never commit .env.
# TMDB API base URL. Must end with a slash.
API_HOST=https://api.themoviedb.org/3/
# Request timeout in milliseconds.
API_TIMEOUT=10000
# TMDB "API Read Access Token" (v4 auth), from https://www.themoviedb.org/settings/api
ACCESS_TOKEN=
